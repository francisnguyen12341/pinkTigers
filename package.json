{
    "scripts": {
        "start": "cd app && node server.js",
        "setup": "psql -U postgres -f setup.sql",
        "drop": "psql -U postgres -f drop.sql",
        "runTest": "psql -U postgres -f drop.sql && psql -U postgres -f setup.sql && cd app && node server.js",
        "testWUser": "psql -U postgres -f testWithUser.sql && cd app && node server.js",
        "build": "echo \"window.ENV = { BACKEND_URL: '${BACKEND_URL}' }\" > app/public/config.js"
    },
    "dependencies": {
        "argon2": "^0.30.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cytoscape": "^3.33.1",
        "easymde": "^2.20.0",
        "express": "^4.18.2",
        "install": "^0.13.0",
        "multer": "^2.0.2",
        "pg": "^8.16.3"
    }
}
